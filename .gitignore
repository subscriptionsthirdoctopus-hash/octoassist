# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.env

# .NET
bin/
obj/
*.user

# WiX
*.wixobj
*.wixpdb

# Build outputs
dist/
deploy/out/
*.pfx
*.msi

# Docker — generated secrets, never commit
deploy/docker/.env

# IDE
.vscode/
.idea/
*.swp
.DS_Store
# macOS AppleDouble resource forks — these are binary and break linters that
# try to read them as source (server/app/web/._views.py was committed once).
._*

# Coding agent tool configs (Antigravity)
.gemini/

# Local scratch / debug
scratch/
server/test_*.py

# Office open-document lock files + root-level Word drafts
~$*
/*.docx
