<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="OctoAssist Asset Agent"
           Manufacturer="Third Octopus"
           Version="0.1.0"
           UpgradeCode="9b6a8d5e-4d3a-4e9d-9c4b-7c9a3a1f4d11"
           Scope="perMachine"
           InstallerVersion="500">

    <!-- MSI properties supplied at install time:
         msiexec /i OctoAssistAgent.msi SERVER_URL=https://... ENROLMENT_KEY=... /qn -->
    <Property Id="SERVER_URL" Secure="yes" />
    <Property Id="ENROLMENT_KEY" Secure="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Launch Condition="Installed OR (SERVER_URL AND ENROLMENT_KEY)"
            Message="OctoAssist Agent install requires SERVER_URL and ENROLMENT_KEY MSI properties." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Media Id="1" Cabinet="agent.cab" EmbedCab="yes" />

    <Feature Id="AgentFeature" Title="OctoAssist Agent" Level="1">
      <ComponentGroupRef Id="AgentBinaries" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="VENDORDIR" Name="Third Octopus">
        <Directory Id="INSTALLDIR" Name="OctoAssist Agent" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AgentBinaries" Directory="INSTALLDIR">
      <Component Id="AgentExe" Guid="*">
        <File Id="OctoAssistAgentExe"
              Source="$(AgentSourceDir)\OctoAssistAgent.exe"
              KeyPath="yes" />

        <ServiceInstall Id="AgentServiceInstall"
                        Name="OctoAssistAgent"
                        DisplayName="OctoAssist Asset Agent"
                        Description="Reports endpoint hardware, software inventory, and logged-in user to the OctoAssist ITSM server. © Third Octopus."
                        Start="auto"
                        Type="ownProcess"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes" />

        <ServiceControl Id="AgentServiceControl"
                        Name="OctoAssistAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- Custom action: invoke the agent EXE in --bootstrap mode to write agent.json
         before the service is started. -->
    <CustomAction Id="WriteAgentConfig"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]OctoAssistAgent.exe&quot; --bootstrap --server-url=&quot;[SERVER_URL]&quot; --enrolment-key=&quot;[ENROLMENT_KEY]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="SetWriteAgentConfigData"
                  Property="WriteAgentConfig"
                  Value="SERVER_URL=[SERVER_URL];ENROLMENT_KEY=[ENROLMENT_KEY]" />

    <InstallExecuteSequence>
      <Custom Action="SetWriteAgentConfigData" Before="WriteAgentConfig" Condition="NOT Installed" />
      <Custom Action="WriteAgentConfig" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

  </Package>
</Wix>
