<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site configuration for OctoAssist.
  Acts as a reverse proxy in front of the FastAPI app on 127.0.0.1:8080.

  Requires:
    - IIS Web Server role
    - URL Rewrite module
    - Application Request Routing (with proxy enabled at server level)
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- Static content served directly from the app (Jinja templates render
             links to /static/*) — proxy these too so we have a single origin. -->
        <rule name="OctoAssist Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST"  value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="{HTTPS_OR_HTTP}" />
            <set name="HTTP_X_FORWARDED_FOR"   value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>
      <rewriteMaps>
        <rewriteMap name="HTTPS_OR_HTTP">
          <add key="ON"  value="https" />
          <add key="OFF" value="http" />
        </rewriteMap>
      </rewriteMaps>
    </rewrite>

    <httpErrors errorMode="DetailedLocalOnly" />
    <directoryBrowse enabled="false" />

    <!-- Allow the X-Forwarded-* server variables to be set above. -->
    <security>
      <requestFiltering>
        <verbs allowUnlisted="true" />
        <fileExtensions allowUnlisted="true" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
