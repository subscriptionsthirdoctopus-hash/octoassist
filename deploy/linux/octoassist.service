[Unit]
Description=OctoAssist ITSM server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=octoassist
Group=octoassist
WorkingDirectory=/opt/octoassist
EnvironmentFile=/opt/octoassist/.env
ExecStart=/opt/octoassist/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
